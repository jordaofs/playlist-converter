APP_ENV=development
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
DATABASE_PATH=data/converter.db
ASSETS_PATH=web/dist
# Comma-separated CIDRs of the reverse proxy; leave empty when nothing sits in front.
TRUSTED_PROXY_CIDRS=
TOKEN_KEY_ID=v1
# Supply a base64 encoded 32-byte encryption key through your secret manager.
TOKEN_ENCRYPTION_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
